+  // Zen: YouTube reports a placeholder seekable range for live streams; the
+  // player's progress state has the real one, in player time (media time plus
+  // offset). Streams without DVR report allowSeeking false.
+  getLiveWindow(video) {
+    let progress = this.player?.getProgressState?.();
+    if (!this.isLive(video) || !progress?.allowSeeking) {
+      return null;
+    }
+    let offset = Number(progress.offset) || 0;
+    return {
+      start: Number(progress.seekableStart) - offset,
+      end: Number(progress.seekableEnd) - offset,
+      atLiveEdge: !!progress.isAtLiveHead,
+    };
+  }
+
+  goToLiveEdge(video) {
+    if (typeof this.player?.seekToLiveHead == "function") {
+      this.player.seekToLiveHead();
+    } else {
+      let liveWindow = this.getLiveWindow(video);
+      if (liveWindow) {
+        video.currentTime = Math.max(liveWindow.start, liveWindow.end - 3);
+      }
+    }
+  }
